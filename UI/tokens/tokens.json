{
  "$schema": "https://json.schemastore.org/design-tokens",
  "name": "RusToK Design Tokens",
  "version": "1.0.0",
  "radius": {
    "sm": 6,
    "md": 10,
    "lg": 14
  },
  "spacing": {
    "1": 4,
    "2": 8,
    "3": 12,
    "4": 16,
    "5": 20,
    "6": 24
  },
  "typography": {
    "fontSans": "\"Inter\", system-ui, -apple-system, Segoe UI, Roboto, sans-serif",
    "fontMono": "\"JetBrains Mono\", monospace",
    "fontSize": {
      "xs": 12,
      "sm": 14,
      "md": 16,
      "lg": 18
    }
  },
  "shadows": {
    "sm": "0 1px 2px rgba(0, 0, 0, 0.08)",
    "md": "0 4px 12px rgba(0, 0, 0, 0.12)",
    "lg": "0 12px 28px rgba(0, 0, 0, 0.18)"
  },
  "colors": {
    "light": {
      "bg": "#ffffff",
      "fg": "#0f172a",
      "muted": "#f1f5f9",
      "mutedFg": "#64748b",
      "border": "#e2e8f0",
      "primary": "#0f172a",
      "primaryFg": "#f8fafc",
      "accent": "#f1f5f9",
      "accentFg": "#0f172a",
      "danger": "#ef4444",
      "dangerFg": "#f8fafc"
    },
    "dark": {
      "bg": "#0f172a",
      "fg": "#f8fafc",
      "muted": "#1e293b",
      "mutedFg": "#94a3b8",
      "border": "#1e293b",
      "primary": "#f8fafc",
      "primaryFg": "#0f172a",
      "accent": "#1e293b",
      "accentFg": "#f8fafc",
      "danger": "#7f1d1d",
      "dangerFg": "#f8fafc"
    }
  }
}
