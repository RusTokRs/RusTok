{
  "schema_version": 1,
  "module": "blog",
  "surface": "article_richtext_offline_backfill",
  "status": "executable_no_run",
  "compile_policy": "not_run_by_request",
  "runner": "cargo run -p rustok-blog --bin blog_article_richtext_backfill --",
  "source": "crates/rustok-blog/src/bin/blog_article_richtext_backfill.rs",
  "verifier": "scripts/verify/verify-blog-richtext-offline-backfill.mjs",
  "safety": {
    "default_mode": "dry_run",
    "apply_flag": "--apply",
    "markdown_plain_text_flag": "--allow-markdown-plain-text",
    "preflight_before_apply": true,
    "post_apply_verification": true,
    "optimistic_updates": true,
    "checkpoint_mutation": false,
    "report_contains_content_bodies": false,
    "supported_source_formats": [
      "richtext",
      "rt_json_v1",
      "rt_json",
      "markdown"
    ],
    "unsupported_formats_fail_closed": true,
    "target_format": "richtext",
    "executes_schema_migration": false,
    "executes_search_reindex": false,
    "orphan_rows_fail_closed": true,
    "stable_cursor": "updated_at_id",
    "optimistic_updated_at_predicate": true
  },
  "validation": {
    "tests_run": false,
    "cargo_run": false,
    "verifier_run": false
  }
}
