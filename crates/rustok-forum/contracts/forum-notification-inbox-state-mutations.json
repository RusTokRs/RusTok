  "policy": {
    "ownership_scope": "exact non-nil notification tenant and recipient identities",
    "missing_foreign_result": "missing cross-tenant and cross-recipient rows return the same unavailable decision",
    "foreign_calls": "state mutations call no recipient privacy source provider or delivery owner",
    "mark_seen": "advance unread to seen and set seen_at once",
    "mark_read": "advance unread or seen to read; direct unread to read sets seen_at and read_at to the same timestamp",
    "archive": "advance every non-archived row to archived and set archived_at once",
    "monotonicity": "seen never downgrades read or archived; read never unarchives; archived is terminal",
    "idempotency": "same or later-state commands preserve state timestamps and updated_at",
    "timestamp_preservation": "seen to read preserves seen_at and archive preserves existing seen_at and read_at",
    "response": "return only changed plus notification state and inbox timestamps",
    "delivery_boundary": "state commands do not create or mutate delivery attempts",
    "transport_boundary": "no HTTP GraphQL native server function or UI adapter is delivered"
  },
  "composition": {
