    "candidate_limit_precedence": [
      "link_limit",
      "mention_limit",
      "attachment_limit"
    ],
    "empty_rules_allow": true,
    "reserved_duplicate_content_not_evaluated": true,
    "reserved_external_score_not_evaluated": true,
    "body_size_rule_invented": false,
    "forum_user_stats_read": false,
    "owner_fact_ports_added": false,
    "policy_persistence_added": false,
    "posting_owner_enforcement_added": false,
    "rate_limit_execution_added": false,
    "duplicate_hashing_added": false,
    "external_ai_scoring_call_added": false,
    "trust_state_write_changed": false,
    "automatic_trust_change_added": false,
    "migration_changed": false,
    "transport_changed": false
  },
  "precedence": [
