    "state_delegation": "every selected identity delegates to NotificationInboxStateService",
    "response": "scanned changed next_cursor and has_more only",
    "empty_foreign_result": "missing foreign and already-satisfied group scopes return an empty page",
    "retry_semantics": "earlier exact transitions remain durable and idempotent if a later database operation fails",
    "privacy_boundary": "no recipient privacy or source target authorization is invoked inside the state owner",
    "delivery_boundary": "no delivery attempt is created or changed",
    "transport_boundary": "no HTTP GraphQL native server function admin or storefront adapter is delivered"
