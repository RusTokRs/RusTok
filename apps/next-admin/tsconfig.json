{
  "compilerOptions": {
    "lib": ["dom", "dom.iterable", "es2022"],
    "allowJs": false,
    "skipLibCheck": true,
    "strict": true,
    "forceConsistentCasingInFileNames": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "preserveSymlinks": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "paths": {
      "@/*": ["./src/*"],
      "@iu/*": ["../../UI/next/components/*"],
      "@rustok/ui-grid": ["../../packages/rustok-ui-grid/src/index.ts"],
      "@rustok/ui-grid/*": ["../../packages/rustok-ui-grid/src/*"],
      "@rustok/forms-admin": ["./packages/forms/src/index.ts"],
      "@rustok/media-admin": ["./packages/media/src/index.ts"],
      "@rustok/pages-admin": ["./packages/pages/src/index.ts"],
      "@/shared/*": ["./src/shared/*"],
      "@/entities/*": ["./src/entities/*"],
      "@/widgets/*": ["./src/widgets/*"],
      "~/*": ["./public/*"],
      "@rustok/ui-controls/*": ["../../packages/rustok-ui-controls/src/*"],
      "@rustok/ui-controls": ["../../packages/rustok-ui-controls/src/index.ts"],
      "react": ["./node_modules/@types/react", "./node_modules/react"],
      "react/*": ["./node_modules/@types/react/*", "./node_modules/react/*"],
      "react/jsx-runtime": [
        "./node_modules/@types/react/jsx-runtime.d.ts",
        "./node_modules/react/jsx-runtime"
      ],
      "clsx": ["./node_modules/clsx"],
      "tailwind-merge": ["./node_modules/tailwind-merge"]
    },
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "target": "ES2022"
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts"
  ],
  "exclude": ["node_modules", "__CLEANUP__", "tests"]
}
