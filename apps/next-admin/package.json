    "test:modules": "node --test src/shared/api/modules.test.mjs",
    "lint:fix": "eslint src --fix && prettier --write src",
    "lint:strict": "eslint src --max-warnings=0",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:install": "playwright install chromium",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "husky",
    "test:forum": "node --experimental-strip-types --test packages/forum/src/api/forum.test.mjs packages/forum/src/components/forum-reply-editor.test.mjs"
  },
  "lint-staged": {
    "**/*.{js,jsx,tsx,ts,css,less,scss,sass}": [
