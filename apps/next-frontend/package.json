{
  "name": "@rustok/next-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "lint:blog": "eslint packages/rustok-blog/src",
    "typegen:i18n": "next-fluent typegen -i messages/en.ftl -o src/types/i18n.d.ts",
    "typecheck": "npm run typegen:i18n && next typegen && tsc --noEmit",
    "test:graphql": "node --experimental-strip-types --test src/shared/lib/graphql.test.mjs",
    "test:modules": "node --experimental-strip-types --test src/modules/registry.test.mjs",
    "test": "npm run test:graphql && npm run test:modules && npm run verify:seo-runtime-fixtures && npm run verify:fly-actions-parity",
    "test:forum": "node --experimental-strip-types --test packages/rustok-forum/src/api/category-pages.test.mjs packages/rustok-forum/src/api/forum-unread.test.mjs packages/rustok-forum/src/api/forum-selection.test.mjs packages/rustok-forum/src/components/category-overview-hierarchy.test.mjs packages/rustok-forum/src/components/quote-tooltip.test.mjs packages/rustok-forum/src/components/composer-preview.test.mjs packages/rustok-forum/src/components/topic-recovery.test.mjs packages/rustok-forum/src/components/thread-navigation.test.mjs packages/rustok-forum/src/components/topic-feed-selection.test.mjs packages/rustok-forum/src/components/thread-paging.test.mjs packages/rustok-forum/src/components/use-thread-navigation.test.mjs packages/rustok-forum/src/components/topic-reply-availability.test.mjs packages/rustok-forum/src/context/draft-storage.test.mjs src/shared/lib/graphql.test.mjs",
    "test:pages": "node --experimental-strip-types --test packages/rustok-pages/src/pages-frontend.test.mjs",
    "test:cart": "node --experimental-strip-types --test packages/rustok-cart/src/cart-frontend.test.mjs",
    "test:comments": "node --test packages/rustok-comments/src/comment-composer.test.mjs",
    "test:notifications": "node --experimental-strip-types --test packages/rustok-notifications/src/notifications-frontend.test.mjs",
    "test:order": "node --experimental-strip-types --test packages/rustok-order/src/order-frontend.test.mjs",
    "test:pricing": "node --experimental-strip-types --test packages/rustok-pricing/src/pricing-frontend.test.mjs",
    "test:product": "node --experimental-strip-types --test packages/rustok-product/src/catalog/pricing.test.mjs packages/rustok-product/src/product-frontend.test.mjs",
    "test:profiles": "node --experimental-strip-types --test packages/rustok-profiles/src/profiles-frontend.test.mjs",
    "test:blog": "node --experimental-strip-types --test packages/rustok-blog/src/utils/comments-order.test.mjs packages/rustok-blog/src/utils/reading-time.test.mjs packages/rustok-blog/src/utils/reactions.test.mjs",
    "test:seo": "node --experimental-strip-types --test packages/rustok-seo/src/seo-frontend.test.mjs",
    "test:search": "node --experimental-strip-types --test packages/search/src/search-frontend.test.mjs",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:install": "playwright install chromium",
    "verify:seo-runtime-fixtures": "node scripts/verify-seo-runtime-fixtures.mjs && node scripts/verify-forum-route-fixture.mjs",
    "verify:fly-actions-parity": "node scripts/verify-fly-actions-parity.mjs",
    "test:storefront-buyer": "node --experimental-strip-types --test packages/rustok-product/src/catalog/buyer.test.mjs packages/rustok-product/src/catalog/pricing.test.mjs packages/rustok-cart/src/core.test.mjs packages/rustok-pricing/src/core.test.mjs"
  },
  "dependencies": {
    "@apollo/client": "^4.3.6",
    "@radix-ui/react-slot": "^1.5.0",
    "@rustok/blog-frontend": "file:./packages/rustok-blog",
    "@rustok/cart-frontend": "file:./packages/rustok-cart",
    "@rustok/comments-frontend": "file:./packages/rustok-comments",
    "@rustok/forum-frontend": "file:./packages/rustok-forum",
    "@rustok/next-fluent": "github:RusTokRs/next-fluent#14f870bb900069762054dc882427c654a69822be",
    "@rustok/notifications-frontend": "file:./packages/rustok-notifications",
    "@rustok/order-frontend": "file:./packages/rustok-order",
    "@rustok/pages-frontend": "file:./packages/rustok-pages",
    "@rustok/pricing-frontend": "file:./packages/rustok-pricing",
    "@rustok/product-frontend": "file:./packages/rustok-product",
    "@rustok/profiles-frontend": "file:./packages/rustok-profiles",
    "@rustok/search-frontend": "file:./packages/search",
    "@rustok/seo-frontend": "file:./packages/rustok-seo",
    "@rustok/richtext": "file:../../packages/richtext",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.1",
    "graphql": "^17.0.2",
    "@rustok/ui-auth": "file:../../packages/rustok-ui-auth",
    "@rustok/ui-grid": "file:../../packages/rustok-ui-grid",
    "lucide-react": "^1.48.0",
    "next": "16.4.5",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "rxjs": "7.8.2",
    "tailwind-merge": "^3.7.0",
    "tailwindcss-animate": "^1.0.7",
    "zod": "^4.6.7",
    "@rustok/ui-controls": "file:../../packages/rustok-ui-controls"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@tailwindcss/postcss": "^4.3.4",
    "@types/node": "^26.1.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "autoprefixer": "^10.6.2",
    "eslint": "10.14.0",
    "eslint-config-next": "16.4.5",
    "postcss": "^8.5.32",
    "tailwindcss": "^4.1.18",
    "typescript": "6.0.3"
  },
  "license": "BUSL-1.1"
}
