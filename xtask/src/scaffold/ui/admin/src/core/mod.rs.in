use rustok_grid::{GridColumnDef, GridPagination};

use crate::i18n::t;
use crate::model::{Record, RecordPage};

pub(crate) mod editor;
pub(crate) mod list;
pub(crate) mod settings;

pub(crate) fn columns(locale: Option<&str>) -> Vec<GridColumnDef> {
    vec![
        GridColumnDef::new("title", t(locale, "records-title", "Title")),
        GridColumnDef::new("publication", t(locale, "records-status", "Status")),
        GridColumnDef::new("locale", t(locale, "records-locale", "Content language")),
        GridColumnDef::actions("edit", t(locale, "record-actions", "Actions")),
    ]
}

pub(crate) fn cell(record: &Record, column: &str, locale: Option<&str>) -> String {
    match column {
        "title" => record.title.clone(),
        "publication" if record.published => t(locale, "records-published", "Published"),
        "publication" => t(locale, "records-draft", "Draft"),
        "locale" => record.effective_locale.clone(),
        _ => String::new(),
    }
}

pub(crate) fn pagination(page: &RecordPage) -> GridPagination {
    GridPagination::new(page.page as usize, usize::from(page.per_page), page.total)
}

#[cfg(test)]
mod tests {
    use super::*;

    #[test]
    fn columns_follow_the_ui_locale() {
        assert_eq!(columns(Some("ru"))[0].title, "Название");
    }
}
