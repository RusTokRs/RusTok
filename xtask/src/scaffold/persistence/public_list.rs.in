use std::{sync::Arc, time::Duration};

use rustok_api::{PortActor, PortContext, PortError, PortErrorKind, RequestContext};
use rustok_channel_ports::{
    CHANNEL_PUBLIC_MODULE_READ_CLAIM, ChannelPublicModuleReadPort, ChannelPublicModuleSelector,
    ReadChannelPublicModule,
};
use rustok_index::{
    EntityName, FieldName, FieldPath, IndexQuery, IndexQueryExecutionError, IndexQueryPage,
    IndexQueryPort, IndexQueryScope, IndexValue, LocaleKey, ModuleName, Pagination,
    PersistedSchemaReadinessFailure, PostgresQueryBuildError, PostgresQueryDecodeError,
    PostgresQueryPageBuildError, SchemaRef, SchemaVersion, SharedIndexQueryRuntime,
};
use uuid::Uuid;

const MODULE: &str = "__SLUG__";

pub(crate) struct PublicRecordReader {
    channel: Option<Arc<dyn ChannelPublicModuleReadPort>>,
    index: Option<SharedIndexQueryRuntime>,
}

impl PublicRecordReader {
    pub(crate) fn new(
        channel: Option<Arc<dyn ChannelPublicModuleReadPort>>,
        index: Option<SharedIndexQueryRuntime>,
    ) -> Self {
        Self { channel, index }
    }

    /// The transport supplies a trusted, tenant-bound request scope.
    pub(crate) async fn list(
        &self,
        request: &RequestContext,
        first: u32,
        after: Option<String>,
    ) -> Result<PublicRecordPage, PortError> {
        let pagination = Pagination::Cursor { first, after };
        pagination.validate().map_err(|error| {
            PortError::validation("__SLUG__.public_records.invalid_page", error.to_string())
        })?;
        let Some(channel_id) = request.channel_id else {
            return Ok(PublicRecordPage::default());
        };
        if !self.channel_allowed(request, channel_id).await? {
            return Ok(PublicRecordPage::default());
        }

        let index = self.index.as_ref().ok_or_else(unavailable)?;
        let query = IndexQuery {
            scope: IndexQueryScope {
                tenant_id: request.tenant_id,
                locale: Some(LocaleKey::new(&request.locale).map_err(operation_error)?),
            },
            schema: SchemaRef {
                module: ModuleName::new(env!("CARGO_PKG_NAME")).map_err(operation_error)?,
                entity: EntityName::new("__ENTITY_SLUG__").map_err(operation_error)?,
                version: SchemaVersion::INITIAL,
            },
            fields: vec![FieldPath::new(
                FieldName::new("title").map_err(operation_error)?,
            )],
            filter: None,
            order_by: Vec::new(),
            pagination,
            include_exact_count: false,
        };
        match index.execute_query(query).await {
            Ok(page) => PublicRecordPage::from_index(page),
            Err(IndexQueryExecutionError::SchemaNotReady {
                reason: PersistedSchemaReadinessFailure::Missing,
                ..
            }) => Ok(PublicRecordPage::default()),
            Err(IndexQueryExecutionError::Build(PostgresQueryPageBuildError::Query(
                PostgresQueryBuildError::Cursor(_),
            )))
            | Err(IndexQueryExecutionError::Decode(PostgresQueryDecodeError::Cursor(_))) => {
                Err(PortError::validation(
                    "__SLUG__.public_records.invalid_cursor",
                    "Invalid continuation cursor",
                ))
            }
            Err(error) => Err(operation_error(error)),
        }
    }

    async fn channel_allowed(
        &self,
        request: &RequestContext,
        channel_id: Uuid,
    ) -> Result<bool, PortError> {
        let port = self.channel.as_ref().ok_or_else(unavailable)?;
        let context = PortContext::new(
            request.tenant_id.to_string(),
            PortActor::service(MODULE),
            request.locale.clone(),
            request.correlation_id.clone(),
        )
        .with_claim(CHANNEL_PUBLIC_MODULE_READ_CLAIM)
        .with_deadline(Duration::from_secs(2));

        match port
            .is_public_module_available(
                context,
                ReadChannelPublicModule {
                    channel: ChannelPublicModuleSelector::Id(channel_id),
                    module_slug: MODULE.into(),
                },
            )
            .await
        {
            Ok(allowed) => Ok(allowed),
            Err(error) if error.kind == PortErrorKind::NotFound => Ok(false),
            Err(error) => Err(operation_error(error)),
        }
    }
}

pub(crate) struct PublicRecord {
    pub id: Uuid,
    pub title: String,
}

#[derive(Default)]
pub(crate) struct PublicRecordPage {
    pub items: Vec<PublicRecord>,
    pub has_more: bool,
    pub next_cursor: Option<String>,
}

impl PublicRecordPage {
    fn from_index(page: IndexQueryPage) -> Result<Self, PortError> {
        let items = page
            .items
            .into_iter()
            .map(|item| {
                let mut fields = item.fields.into_iter();
                match (fields.next().map(|field| field.value), fields.next()) {
                    (Some(IndexValue::String(title)), None) => Ok(PublicRecord {
                        id: item.entity_id,
                        title,
                    }),
                    _ => Err(operation_error(
                        "Index returned an invalid public title projection",
                    )),
                }
            })
            .collect::<Result<_, _>>()?;
        Ok(Self {
            items,
            has_more: page.has_more,
            next_cursor: page.next_cursor,
        })
    }
}

fn unavailable() -> PortError {
    PortError::unavailable(
        "__SLUG__.public_records.unavailable",
        "Public records unavailable",
    )
}

fn operation_error(error: impl std::fmt::Display) -> PortError {
    tracing::error!(module_slug = MODULE, %error, "Public record query failed");
    unavailable()
}
