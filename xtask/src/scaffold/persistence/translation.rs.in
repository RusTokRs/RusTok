use sea_orm::entity::prelude::*;

#[derive(Clone, Debug, PartialEq, Eq, DeriveEntityModel)]
#[sea_orm(table_name = "__TRANSLATIONS__")]
pub struct Model {
    #[sea_orm(primary_key, auto_increment = false)]
    pub tenant_id: Uuid,
    #[sea_orm(primary_key, auto_increment = false)]
    pub record_id: Uuid,
    #[sea_orm(primary_key, auto_increment = false)]
    pub locale: String,
    pub title: String,
}

#[derive(Clone, Copy, Debug, EnumIter, DeriveRelation)]
pub enum Relation {}

impl ActiveModelBehavior for ActiveModel {}

impl Related<super::record::Entity> for Entity {
    fn to() -> RelationDef {
        record_relation()
    }
}

pub(crate) fn record_relation() -> RelationDef {
    Entity::belongs_to(super::record::Entity)
        .from((Column::TenantId, Column::RecordId))
        .to((super::record::Column::TenantId, super::record::Column::Id))
        .into()
}
