use async_graphql::{Context, FieldError, Object, Result, SimpleObject};
use rustok_api::{PortErrorKind, RequestContext, TenantContext, graphql::GraphQLError};
use uuid::Uuid;

use crate::services::PublicRecordPage;

use super::__MODULE_STEM__AdminGraphqlData;

#[derive(Default)]
pub(super) struct StorefrontQuery;

#[Object(name = "__MODULE_STEM__StorefrontQuery")]
impl StorefrontQuery {
    #[graphql(name = "storefront__MODULE_STEM__Records")]
    async fn records(
        &self,
        ctx: &Context<'_>,
        #[graphql(default = 25)] first: u32,
        after: Option<String>,
    ) -> Result<StorefrontPage> {
        let request = ctx.data_opt::<RequestContext>().ok_or_else(|| {
            FieldError::permission_denied("Trusted public request context required")
        })?;
        let tenant = ctx.data::<TenantContext>()?;
        if !tenant.is_active || tenant.id.is_nil() || tenant.id != request.tenant_id {
            return Err(FieldError::permission_denied(
                "Invalid public request authority",
            ));
        }
        let runtime = ctx.data::<__MODULE_STEM__AdminGraphqlData>()?;
        runtime
            .public_records
            .list(request, first, after)
            .await
            .map(Into::into)
            .map_err(|error| {
                if error.kind == PortErrorKind::Validation {
                    FieldError::bad_user_input(&error.message)
                } else {
                    FieldError::internal_error("Public records are temporarily unavailable")
                }
            })
    }
}

#[derive(SimpleObject)]
#[graphql(name = "__MODULE_STEM__StorefrontRecordsPage")]
struct StorefrontPage {
    items: Vec<StorefrontRecord>,
    has_more: bool,
    next_cursor: Option<String>,
}

impl From<PublicRecordPage> for StorefrontPage {
    fn from(page: PublicRecordPage) -> Self {
        Self {
            items: page
                .items
                .into_iter()
                .map(|item| StorefrontRecord {
                    id: item.id,
                    title: item.title,
                })
                .collect(),
            has_more: page.has_more,
            next_cursor: page.next_cursor,
        }
    }
}

#[derive(SimpleObject)]
#[graphql(name = "__MODULE_STEM__StorefrontRecord")]
struct StorefrontRecord {
    id: Uuid,
    title: String,
}
