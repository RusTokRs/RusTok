use rustok_api::{AuthContext, Resource, SharedStaticModuleSettingsReader, TenantContext};
use rustok_core::{SecurityContext, security_context_from_access_token};
use sea_orm::DatabaseConnection;

use super::__ENTITY__Service;

impl __ENTITY__Service {
    /// Compose the record owner with the fixed permission contract for admin adapters.
    pub fn for_admin(db: DatabaseConnection, settings: SharedStaticModuleSettingsReader) -> Self {
        Self::new(db, Resource::__RESOURCE__).with_settings_reader(settings)
    }
}

/// Derive owner authority from the current authenticated tenant.
pub fn admin_record_security(
    tenant: &TenantContext,
    auth: &AuthContext,
) -> Option<SecurityContext> {
    if !tenant.is_active
        || tenant.id.is_nil()
        || auth.user_id.is_nil()
        || auth.tenant_id != tenant.id
    {
        return None;
    }
    Some(security_context_from_access_token(
        auth.user_id,
        &auth.grant_type,
        &auth.permissions,
    ))
}

/// Revisions cross browser transports as canonical positive decimal strings.
pub fn admin_record_revision(value: &str) -> Option<i64> {
    value
        .parse::<i64>()
        .ok()
        .filter(|revision| *revision > 0 && revision.to_string() == value)
}
