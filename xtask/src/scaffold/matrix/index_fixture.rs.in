use std::sync::Arc;

use rustok_api::Resource;
use rustok_core::{
    MigrationSource, ModuleEventListenerContext, ModuleEventListenerRegistry, RusToKModule,
    SecurityContext,
    events::{EventDispatcher, MemoryTransport},
};
use rustok_events::{
    ContractEventEnvelope, LOCALIZED_INDEX_REFRESH_EVENT_TYPE, LocalizedIndexRefreshEvent,
};
use rustok_index::{
    EntityKey, EntityName, FieldName, IndexModule, IndexMutation, IndexSchemaSourceCatalog,
    IndexSourceLoadRequest, IndexSourceScanRequest, IndexValue, LocaleKey, ModuleName,
    MutationApplyOutcome, MutationDelivery, PostgresMutationStore, SchemaRef, SchemaVersion,
    SharedIndexSchemaRegistry, SharedIndexSourceRegistry, materialize_index_source_registry,
    materialize_postgres_index_query_runtime, materialize_postgres_index_sources,
};
use rustok_outbox::{OutboxRelay, SysEvents};
use rustok_scaffold_matrix_localized::{
    ProductService, SaveProductTitle, ScaffoldMatrixLocalizedModule,
};
use rustok_test_utils::db::{
    assert_postgres_url, connect_postgres, create_postgres_database,
    drop_postgres_database_if_exists, postgres_database_url, unique_postgres_database_name,
};
use sea_orm::{ConnectionTrait, DatabaseConnection, EntityTrait, Statement};
use sea_orm_migration::{MigrationTrait, SchemaManager};
use uuid::Uuid;

const INDEX_SOURCE: &str = "scaffold_matrix_localized-localized-records";

fn localized_schema() -> SchemaRef {
    SchemaRef {
        module: ModuleName::new("rustok-scaffold-matrix-localized").unwrap(),
        entity: EntityName::new("product").unwrap(),
        version: SchemaVersion::INITIAL,
    }
}

#[test]
fn distribution_registers_the_localized_owner_index_schema() {
    let registry = rustok_distribution::build_registry();
    let extensions = rustok_distribution::build_runtime_extensions(&registry).unwrap();
    let catalog = extensions.get::<IndexSchemaSourceCatalog>().unwrap();
    assert!(catalog.get(&localized_schema()).is_some());
}

#[tokio::test]
#[ignore = "requires the disposable PostgreSQL URL used by the scaffold matrix"]
async fn postgres_localized_owner_replays_into_index() {
    let admin_url = std::env::var("RUSTOK_SCAFFOLD_TEST_POSTGRES_URL").unwrap();
    assert_postgres_url(&admin_url);
    let admin = connect_postgres(&admin_url).await.unwrap();
    let name = unique_postgres_database_name("scaffold_localized_index");
    create_postgres_database(&admin, &name).await.unwrap();
    let url = postgres_database_url(&admin_url, &name);
    let result = tokio::spawn(async move {
        let db = connect_postgres(&url).await.unwrap();
        assert_index_replay(db).await;
    })
    .await;
    drop_postgres_database_if_exists(&admin, &name)
        .await
        .unwrap();
    result.expect("PostgreSQL Index replay contract");
}

async fn assert_index_replay(db: DatabaseConnection) {
    let manager = SchemaManager::new(&db);
    rustok_outbox::SysEventsMigration
        .up(&manager)
        .await
        .unwrap();
    for migration in rustok_migrations::identity::migrations()
        .into_iter()
        .chain(ScaffoldMatrixLocalizedModule.migrations())
        .chain(IndexModule.migrations())
    {
        migration
            .up(&manager)
            .await
            .unwrap_or_else(|error| panic!("{}: {error}", migration.name()));
    }
    index_query::migrate_settings(&manager).await;
    let tenant = Uuid::new_v4();
    let foreign = Uuid::new_v4();
    for id in [tenant, foreign] {
        db.execute_raw(Statement::from_sql_and_values(
            db.get_database_backend(),
            "INSERT INTO tenants (id, name, slug) VALUES ($1, $2, $3)",
            [id.into(), "Scaffold Index".into(), id.to_string().into()],
        ))
        .await
        .unwrap();
    }

    let registry = rustok_distribution::build_registry();
    let mut extensions = rustok_distribution::build_runtime_extensions(&registry).unwrap();
    let queries = materialize_postgres_index_query_runtime(&mut extensions, db.clone())
        .unwrap()
        .unwrap();
    let public = index_query::PublicQueries {
        db: &db,
        tenant,
        runtime: &queries,
    };
    materialize_postgres_index_sources(&mut extensions, db.clone()).unwrap();
    let sources: SharedIndexSourceRegistry = materialize_index_source_registry(&extensions)
        .unwrap()
        .unwrap();
    let schemas = extensions
        .get::<SharedIndexSchemaRegistry>()
        .unwrap()
        .shared();
    let reference = localized_schema();
    let mut listeners = ModuleEventListenerRegistry::new();
    IndexModule.register_event_listeners(
        &mut listeners,
        &ModuleEventListenerContext {
            db: db.clone(),
            extensions: &extensions,
        },
    );
    let transport = MemoryTransport::new();
    let bus = transport.event_bus();
    let mut dispatcher = EventDispatcher::new(bus.clone());
    for listener in listeners.into_handlers() {
        dispatcher.register_boxed(listener);
    }
    let running = dispatcher.start_with_contract_delivery().unwrap();
    let relay = OutboxRelay::new(db.clone(), Arc::new(transport));

    let owner = ProductService::new(db.clone(), Resource::Posts);
    let security = SecurityContext::system();
    let title = |locale: &str, title: &str| SaveProductTitle {
        locale: locale.into(),
        title: title.into(),
    };
    let draft = owner
        .create(tenant, &security, title("en", "English"))
        .await
        .unwrap();
    let draft = owner
        .save_title(
            tenant,
            &security,
            draft.id,
            draft.revision,
            title("ru", "Русский"),
        )
        .await
        .unwrap();
    let published = owner
        .set_publication(tenant, &security, draft.id, draft.revision, true, "en")
        .await
        .unwrap();

    let publication_fact = SysEvents::find()
        .all(&db)
        .await
        .unwrap()
        .into_iter()
        .find(|row| row.event_type == LOCALIZED_INDEX_REFRESH_EVENT_TYPE)
        .expect("the owner enqueued a sealed Index refresh");
    let original: ContractEventEnvelope = serde_json::from_value(publication_fact.payload).unwrap();
    db.execute_unprepared(
        "ALTER TABLE index_entities ADD CONSTRAINT fixture_reject_ru CHECK (locale_key <> 'ru')",
    )
    .await
    .unwrap();
    relay.process_pending_once(None).await.unwrap();
    let pending = SysEvents::find_by_id(publication_fact.id)
        .one(&db)
        .await
        .unwrap()
        .unwrap();
    assert!(pending.dispatched_at.is_none());
    assert_eq!(pending.retry_count, 1);
    assert_eq!(
        index_copies(&db, tenant, draft.id).await,
        [("en".into(), published.revision, false)]
    );

    db.execute_unprepared("ALTER TABLE index_entities DROP CONSTRAINT fixture_reject_ru")
        .await
        .unwrap();
    db.execute_raw(Statement::from_sql_and_values(
        db.get_database_backend(),
        "UPDATE sys_events SET next_attempt_at = NULL WHERE id = $1",
        [publication_fact.id.into()],
    ))
    .await
    .unwrap();
    assert_eq!(relay.process_pending_once(None).await.unwrap(), 1);
    assert!(
        SysEvents::find_by_id(publication_fact.id)
            .one(&db)
            .await
            .unwrap()
            .unwrap()
            .dispatched_at
            .is_some()
    );
    assert_projected_copies(&db, tenant, draft.id, published.revision, false).await;
    public.expect("ru", None).await;
    index_query::PublicQueries {
        tenant: foreign,
        ..public
    }
    .set_discovery(Some(true), serde_json::json!(true))
    .await;
    public.expect("ru", None).await;
    for (enabled, setting) in [
        (None, serde_json::json!(true)),
        (Some(false), serde_json::json!(true)),
        (Some(true), serde_json::json!("true")),
        (Some(true), serde_json::json!(false)),
    ] {
        public.set_discovery(enabled, setting).await;
        public.expect("ru", None).await;
    }
    public
        .set_discovery(Some(true), serde_json::json!(true))
        .await;
    public.expect("en", Some("English")).await;
    public.expect("ru", Some("Русский")).await;
    public.expect("de", None).await;
    public.expect_fallback("de", "ru", Some("Русский")).await;

    for (scope, revision) in [
        (foreign, published.revision),
        (tenant, published.revision + 1),
    ] {
        let invalid = ContractEventEnvelope::new(
            scope,
            None,
            LocalizedIndexRefreshEvent {
                module_slug: "scaffold_matrix_localized".into(),
                entity_type: "product".into(),
                record_id: draft.id,
                source_version: revision as u64,
            },
        )
        .unwrap();
        assert!(bus.publish_contract_envelope(invalid).await.is_err());
    }
    assert!(index_copies(&db, foreign, draft.id).await.is_empty());
    assert_projected_copies(&db, tenant, draft.id, published.revision, false).await;

    let first = sources
        .scan(IndexSourceScanRequest::new(tenant, reference.clone(), None, 1).unwrap())
        .await
        .unwrap();
    assert_eq!(
        first.mutations()[0].key().locale.as_ref().unwrap().as_str(),
        "en"
    );
    let second = sources
        .scan(
            IndexSourceScanRequest::new(tenant, reference.clone(), first.next_cursor().cloned(), 1)
                .unwrap(),
        )
        .await
        .unwrap();
    assert!(second.is_complete());
    let [IndexMutation::Upsert { record, .. }] = second.mutations() else {
        panic!("Russian copy must be present")
    };
    assert_eq!(record.source_version, published.revision as u64);
    assert_eq!(record.key.locale.as_ref().unwrap().as_str(), "ru");
    assert_eq!(
        record.fields[&FieldName::new("title").unwrap()],
        IndexValue::String("Русский".into())
    );
    let russian = record.key.clone();
    let scoped = sources
        .scan(
            IndexSourceScanRequest::for_locale(
                tenant,
                reference.clone(),
                LocaleKey::new("ru").unwrap(),
                None,
                1,
            )
            .unwrap(),
        )
        .await
        .unwrap();
    assert!(scoped.is_complete());
    assert_eq!(scoped.mutations(), second.mutations());
    let crossed_cursor = IndexSourceScanRequest::for_locale(
        tenant,
        reference.clone(),
        LocaleKey::new("ru").unwrap(),
        first.next_cursor().cloned(),
        1,
    )
    .unwrap();
    assert!(sources.scan(crossed_cursor).await.is_err());
    let missing = EntityKey {
        locale: Some(LocaleKey::new("de").unwrap()),
        ..russian.clone()
    };
    let foreign_key = EntityKey {
        tenant_id: foreign,
        ..russian.clone()
    };
    for key in [missing, foreign_key] {
        let result = sources
            .load(IndexSourceLoadRequest::new(vec![key]).unwrap())
            .await
            .unwrap();
        assert!(result.mutations().is_empty());
    }
    let store = PostgresMutationStore::new(db.clone());
    let update = MutationDelivery::from_event(INDEX_SOURCE, second.mutations()[0].clone()).unwrap();
    assert!(matches!(
        store.apply(&schemas, &update).await.unwrap(),
        MutationApplyOutcome::Duplicate { .. }
    ));

    let edited = owner
        .save_title(
            tenant,
            &security,
            draft.id,
            published.revision,
            title("ru", "Обновлено"),
        )
        .await
        .unwrap();
    public.expect("ru", None).await;
    assert_eq!(relay.process_pending_once(None).await.unwrap(), 2);
    assert_projected_copies(&db, tenant, draft.id, edited.revision, false).await;
    public.expect("ru", Some("Обновлено")).await;
    public
        .set_discovery(Some(true), serde_json::json!(false))
        .await;
    public.expect("ru", None).await;
    public
        .set_discovery(Some(true), serde_json::json!(true))
        .await;
    public.expect("ru", Some("Обновлено")).await;
    let edited_copy = sources
        .load(IndexSourceLoadRequest::new(vec![russian.clone()]).unwrap())
        .await
        .unwrap();
    let [mutation @ IndexMutation::Upsert { record, .. }] = edited_copy.mutations() else {
        panic!("published edit must yield an exact-locale upsert");
    };
    assert_eq!(
        record.fields[&FieldName::new("title").unwrap()],
        IndexValue::String("Обновлено".into())
    );
    let delivery = MutationDelivery::from_event(INDEX_SOURCE, mutation.clone()).unwrap();
    assert!(matches!(
        store.apply(&schemas, &delivery).await.unwrap(),
        MutationApplyOutcome::Duplicate { .. }
    ));

    let withdrawn = owner
        .set_publication(tenant, &security, draft.id, edited.revision, false, "en")
        .await
        .unwrap();
    public.expect("en", None).await;
    public.expect("ru", None).await;
    public.expect_fallback("de", "ru", None).await;
    bus.publish_contract_envelope(original).await.unwrap();
    assert_projected_copies(&db, tenant, draft.id, withdrawn.revision, true).await;
    assert_eq!(relay.process_pending_once(None).await.unwrap(), 2);
    let deleted = sources
        .load(IndexSourceLoadRequest::new(vec![russian.clone()]).unwrap())
        .await
        .unwrap();
    let [
        mutation @ IndexMutation::Delete {
            key,
            source_version,
            ..
        },
    ] = deleted.mutations()
    else {
        panic!("withdrawal must yield an exact-locale tombstone")
    };
    assert_eq!(key, &russian);
    assert_eq!(*source_version, withdrawn.revision as u64);
    let tombstone = MutationDelivery::from_event(INDEX_SOURCE, mutation.clone()).unwrap();
    assert!(matches!(
        store.apply(&schemas, &tombstone).await.unwrap(),
        MutationApplyOutcome::Duplicate { .. }
    ));
    let old_replay =
        MutationDelivery::new(INDEX_SOURCE, "late-old-copy", update.mutation().clone()).unwrap();
    assert!(matches!(
        store.apply(&schemas, &old_replay).await.unwrap(),
        MutationApplyOutcome::StaleIgnored { .. }
    ));
    assert_projected_copies(&db, tenant, draft.id, withdrawn.revision, true).await;
    running.stop().await.unwrap();
}

async fn index_copies(db: &DatabaseConnection, tenant: Uuid, id: Uuid) -> Vec<(String, i64, bool)> {
    db.query_all_raw(Statement::from_sql_and_values(
        db.get_database_backend(),
        "SELECT locale_key, CAST(source_version AS BIGINT) AS revision, is_deleted \
         FROM index_entities WHERE tenant_id = $1 AND entity_id = $2 ORDER BY locale_key",
        [tenant.into(), id.into()],
    ))
    .await
    .unwrap()
    .into_iter()
    .map(|row| {
        (
            row.try_get("", "locale_key").unwrap(),
            row.try_get("", "revision").unwrap(),
            row.try_get("", "is_deleted").unwrap(),
        )
    })
    .collect()
}

async fn assert_projected_copies(
    db: &DatabaseConnection,
    tenant: Uuid,
    id: Uuid,
    revision: i64,
    is_deleted: bool,
) {
    assert_eq!(
        index_copies(db, tenant, id).await,
        [
            ("en".into(), revision, is_deleted),
            ("ru".into(), revision, is_deleted)
        ]
    );
}
